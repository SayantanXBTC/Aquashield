# AQUASHIELD backend — copy to backend/.env for local overrides. Never commit backend/.env.

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database (PostgreSQL/PostGIS) ---
# Either set DATABASE_URL directly, or leave unset and these build one —
# see docs/development/database.md. Defaults match infrastructure/docker-compose.yml.
POSTGRES_USER=aquashield
POSTGRES_PASSWORD=aquashield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aquashield
# DATABASE_URL=
#
# tests/conftest.py reads TEST_DATABASE_URL from the real shell environment
# (not from this file — pytest never loads backend/.env) and falls back to
# DATABASE_URL if unset. Point it at a second, disposable database so the
# suite's "empty table" assumptions never collide with real dev/demo data:
#   createdb aquashield_test && psql aquashield_test -c 'CREATE EXTENSION postgis;'
#   DATABASE_URL=postgresql+psycopg://aquashield:@localhost:5433/aquashield_test alembic upgrade head
#   export TEST_DATABASE_URL=postgresql+psycopg://aquashield:@localhost:5433/aquashield_test
# See docs/development/database.md.

# --- Simulation artifacts ---
# Where SimulationService writes prototype JSON timeline artifacts — see
# docs/development/simulation.md. Defaults to simulation/outputs/ if unset.
# SIMULATION_OUTPUT_DIR=

# --- Auth (Firebase Authentication) ---
# The Firebase project whose ID tokens this API accepts (same project as
# the frontend's VITE_FIREBASE_PROJECT_ID). No service account is needed —
# tokens are verified against Google's public certs (app/core/auth.py).
FIREBASE_PROJECT_ID=
# LOCAL DEVELOPMENT ONLY — treat token-less requests as this uid. Pair with
# frontend VITE_AUTH_DEV_BYPASS=1. Never set in a deployed environment.
# AUTH_DEV_BYPASS_UID=dev-operator

# --- AI layer (agents/) ---
# local (default): full LangGraph with deterministic rules, no network/credits.
# anthropic: Claude API via the official SDK; set ANTHROPIC_API_KEY (never committed).
AI_PROVIDER=local
AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# --- RAG layer (rag/) ---
# none (default): EvidenceRetriever returns NOT_CONFIGURED, same posture as
# before this layer existed. chroma: the real hybrid retriever over the
# aquashield_evidence ChromaDB collection — needs sources ingested first
# (`python -m rag ingest`).
RAG_PROVIDER=none
# local (default): DeterministicHashEmbedding, no network/credits. There is
# no hosted embeddings provider wired in yet (Anthropic has none).
RAG_EMBEDDING_PROVIDER=local
RAG_RELEVANCE_THRESHOLD=0.15
# Defaults to the gitignored rag/vectorstore/data/ directory if unset.
# RAG_VECTORSTORE_DIR=
