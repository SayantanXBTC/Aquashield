# AQUASHIELD frontend — copy to frontend/.env.local (never committed).

# Backend API base URL.
VITE_API_URL=http://127.0.0.1:8000

# --- Firebase Authentication (web app config) ---
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# Enable the Google and Email/Password sign-in providers under
# Authentication -> Sign-in method, and add localhost to Authorized domains.
# The same project id goes in backend/.env as FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# LOCAL DEVELOPMENT ONLY — fake signed-in operator before Firebase exists.
# Pair with backend/.env AUTH_DEV_BYPASS_UID. Ignored in production builds.
# VITE_AUTH_DEV_BYPASS=1
