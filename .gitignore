# --- Node / Frontend ---
node_modules/
dist/
build/
.vite/
frontend/dist/
frontend/build/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Env / Secrets ---
.env
.env.local
*.env.*
!.env.example

# --- Generated simulation / RAG data ---
simulation/outputs/*
!simulation/outputs/.gitkeep
rag/vectorstore/*
!rag/vectorstore/.gitkeep

# --- Bulk / external datasets (never commit) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# --- Test / build artifacts ---
coverage/
htmlcov/
.coverage
playwright-report/
test-results/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.log
logs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# --- Local vector databases (top-level, if ever created outside rag/vectorstore) ---
chroma/
vectorstore/

# --- Temporary files ---
tmp/
temp/

# --- Claude Code project config (not part of the application) ---
.claude
skills-lock.json
