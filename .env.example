# AQUASHIELD — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.

# --- Frontend ---
VITE_API_URL=
VITE_WS_URL=

# --- Backend ---
BACKEND_HOST=
BACKEND_PORT=

# --- Database (PostgreSQL/PostGIS — see docs/development/database.md) ---
# Used by infrastructure/docker-compose.yml and by backend/.env's postgres_*
# fields. Defaults (aquashield/aquashield) are LOCAL DEV ONLY placeholders.
POSTGRES_USER=aquashield
POSTGRES_PASSWORD=aquashield
POSTGRES_DB=aquashield
POSTGRES_PORT=5432
# Alternative to the POSTGRES_* fields above: set this directly to override.
DATABASE_URL=

# --- LLM ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- AI layer (agents/) and RAG (rag/) ---
# AI_PROVIDER, AI_MODEL, ANTHROPIC_API_KEY, RAG_PROVIDER, RAG_EMBEDDING_PROVIDER,
# RAG_RELEVANCE_THRESHOLD, RAG_VECTORSTORE_DIR — see backend/.env.example.
# Both default to a local/offline posture (no network, no credits).

# --- External data providers (PLANNED / TO BE DECIDED — see architecture.md §14) ---
DATA_PROVIDER_API_KEY=
