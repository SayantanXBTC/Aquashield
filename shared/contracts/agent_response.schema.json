{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.dev/contracts/agent_response.schema.json",
  "title": "AgentResponse",
  "description": "One AI agent's response to an AgentRequest (architecture.md §9/§24). Not implemented yet.",
  "type": "object",
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "agent_type": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["success", "partial", "error"] },
    "findings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "recommendations": {
      "description": "Zero or more ResponseRecommendation-shaped objects proposed by this agent.",
      "type": "array",
      "items": { "type": "object" }
    },
    "metadata": { "type": "object" }
  },
  "required": ["request_id", "agent_type", "status"],
  "additionalProperties": false
}
